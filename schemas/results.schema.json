{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labcoach.local/schemas/assignment11_results.schema.json",
  "title": "Assignment11Results",
  "type": "object",
  "required": [
    "student_id",
    "framework",
    "safe_queries",
    "attack_queries",
    "rate_limit",
    "edge_cases"
  ],
  "additionalProperties": true,
  "properties": {
    "student_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "framework": {
      "type": "string",
      "minLength": 2
    },
    "safe_queries": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/queryResult" }
    },
    "attack_queries": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/queryResult" }
    },
    "rate_limit": {
      "type": "object",
      "required": ["max_requests", "window_seconds", "sent", "passed", "blocked"],
      "properties": {
        "max_requests": { "type": "integer", "minimum": 1 },
        "window_seconds": { "type": "integer", "minimum": 1 },
        "sent": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "edge_cases": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/queryResult" }
    },
    "judge_sample": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verdict"],
        "properties": {
          "response_preview": { "type": "string" },
          "safety": { "type": "number" },
          "relevance": { "type": "number" },
          "accuracy": { "type": "number" },
          "tone": { "type": "number" },
          "verdict": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "queryResult": {
      "type": "object",
      "required": ["input", "blocked"],
      "properties": {
        "input": { "type": "string" },
        "blocked": { "type": "boolean" },
        "layer": { "type": ["string", "null"] },
        "response_preview": { "type": "string" }
      }
    }
  }
}
